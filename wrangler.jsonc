{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "burg-competition-concessions",
  "main": "src/index.js",
  "compatibility_date": "2026-08-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "MENU_DB",
      "database_name": "burg-competition-concessions",
      "database_id": "REPLACE_WITH_NEW_COMPETITION_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
